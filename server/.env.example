# ==============================================================================
# TaskPilot Server - Environment Configuration
# ==============================================================================

# Server Network Configuration
# PORT: Port where Express server listens (Render assigns this dynamically in production)
PORT=5000

# NODE_ENV: Application environment ('development' or 'production')
# In 'production', SSL is automatically enabled for database connections
NODE_ENV=development

# Database Connection (MySQL / Clever Cloud)
# DB_HOST: Hostname of your MySQL instance (e.g. localhost or your Clever Cloud host)
DB_HOST=localhost

# DB_PORT: MySQL port (default 3306)
DB_PORT=3306

# DB_NAME: Database name (e.g. taskpilot or Clever Cloud database name)
DB_NAME=taskpilot

# DB_USER: Database username
DB_USER=root

# DB_PASSWORD: Database user password
DB_PASSWORD=manager

# DB_DIALECT: Database dialect (default: mysql)
DB_DIALECT=mysql

# DB Connection Pool (Optimized for small / free-tier databases)
DB_POOL_MAX=5
DB_POOL_MIN=0
DB_POOL_IDLE=10000
DB_POOL_ACQUIRE=30000

# DB_SSL: Force enable SSL ('true' or 'false'). Automatically enabled if NODE_ENV=production
DB_SSL=false

# Authentication
# JWT_SECRET: Cryptographic secret key used to sign and verify JSON Web Tokens
JWT_SECRET=super_secret_jwt_key_taskpilot_2026_change_in_production

# JWT_EXPIRES_IN: Lifespan duration for JWT access tokens (e.g. 7d, 24h)
JWT_EXPIRES_IN=7d

# CORS Allowed Origins
# CORS_ORIGIN: Comma-separated list of origins allowed to access the API.
# Include both your local dev client and your deployed Vercel frontend.
CORS_ORIGIN=http://localhost:5173,https://task-pilot-one-tau.vercel.app

# Blocker Escalation Thresholds (Hours or float hours, e.g. 0.0167 for 1 min)
# BLOCKER_NOTIFY_HOURS: Hours before sending warning notification for blocked tasks
BLOCKER_NOTIFY_HOURS=24

# BLOCKER_ESCALATE_HOURS: Hours before escalating unresolved blockers to project manager
BLOCKER_ESCALATE_HOURS=48
